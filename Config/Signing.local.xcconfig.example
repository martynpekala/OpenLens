OPENLENS_WIDGET_BUNDLE_ID = com.example.OpenLens.OpenLensActivityWidget
OPENLENS_TESTS_BUNDLE_ID = com.example.OpenLensTests
OPENLENS_APP_GROUP = group.com.example.OpenLens